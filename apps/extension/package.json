{
  "name": "extension",
  "version": "0.1.0",
  "private": true,
  "description": "Records and replays browser sessions for developers.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "tsc --noEmit && wxt build",
    "build:test": "wxt build --mode test",
    "zip": "wxt zip",
    "wxt:prepare": "wxt prepare",
    "build:poc-d0": "wxt build --mode poc-d0",
    "build:poc-d1": "wxt build --mode poc-d1",
    "build:poc-d2": "wxt build --mode poc-d2",
    "test:manifest": "node --test scripts/manifest.checks.mjs scripts/manifest-poc.checks.mjs"
  },
  "dependencies": {
    "@recnrun/brand": "workspace:*",
    "@recnrun/bridge": "workspace:*",
    "@recnrun/domain": "workspace:*",
    "preact": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@preact/preset-vite": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "web-ext": "catalog:",
    "wxt": "catalog:"
  }
}
