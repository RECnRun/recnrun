    "wxt:prepare": "wxt prepare"
  },
  "dependencies": {
    "@recnrun/isolation-core": "workspace:*",
    "@recnrun/worker-bootstrap": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "wxt": "catalog:"
  }
}
