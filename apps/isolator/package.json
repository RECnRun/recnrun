{
  "name": "@recnrun/isolator",
  "version": "0.1.0",
  "private": true,
  "description": "Namespaced sessions POC extension (docs/poc/namespace-sessions/PLAN.md).",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "vp run @recnrun/worker-bootstrap#build && tsc --noEmit && wxt build",
