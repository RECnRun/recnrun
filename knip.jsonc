{
  // The Oxc Zed extension requires a direct oxfmt dependency to find its LSP executable.
  // dependency-cruiser loads @swc/core by name for its "swc" parser.
  "ignoreDependencies": ["oxfmt", "@swc/core"],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/agent-hooks/*.mjs",
        "scripts/git-hooks/*.mjs",
        "scripts/*.checks.mjs",
        "tests/container/*.checks.mjs",
      ],
    },
    // The future npm bin; F7 points package.json "bin" at its build output.
    "apps/cli": {
      "entry": ["src/bin.ts"],
    },
  },
}
