{
  // The Oxc Zed extension requires a direct oxfmt dependency to find its LSP executable.
  // dependency-cruiser loads @swc/core by name for its "swc" parser.
  "ignoreDependencies": ["oxfmt", "@swc/core"],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/agent-hooks/*.mjs",
        "scripts/git-hooks/*.mjs",
        "scripts/*.checks.mjs",
        "tests/container/*.checks.mjs",
        // Child processes the contract tests spawn.
        "tests/contract/fixtures/*.ts",
        // test:contract:local passes it to `vp test --config`, a command Knip does not parse.
        "tests/contract/vitest.config.ts",
      ],
    },
    // The service's entrypoint, run directly by the contract tests.
    "apps/service": {
      "entry": ["src/bin.ts"],
    },
    // The page scripts, service worker, and dedicated worker the browser loads from public/.
    "apps/fixture": {
      "entry": ["public/index.js", "public/routes/*.js", "public/sw.js", "public/worker.js"],
    },
  },
}
