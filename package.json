{
  "name": "recnrun",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp run verify",
    "dev": "vp run --filter website --filter extension --parallel dev",
    "dev:website": "vp run website#dev",
    "dev:extension": "vp run extension#dev",
    "clean": "node scripts/clean.mjs && vp run extension#wxt:prepare",
    "logo": "node scripts/favicon.mjs && node scripts/logo-png.mjs",
    "test:unit": "node scripts/test-container.mjs test:unit:local",
    "test:unit:local": "vp test --project=website --project=extension --project=@recnrun/domain --project=@recnrun/bridge",
    "test:components": "node scripts/test-container.mjs test:components:local",
    "test:components:local": "vp test --config apps/website/vitest.browser.config.ts && vp test --config apps/extension/vitest.browser.config.ts",
    "test:e2e": "node scripts/test-container.mjs test:e2e:local",
    "test:e2e:local": "vp run --no-cache website#build && vp run --no-cache extension#build:test && playwright test --workers=1",
    "test:coverage": "node scripts/test-container.mjs test:coverage:local",
    "test:coverage:local": "vp test --coverage",
    "test:container": "node --test tests/container/runner.checks.mjs",
    "test:hooks": "node --test scripts/agent-hooks/*.checks.mjs scripts/git-hooks/*.checks.mjs",
    "test:extension-manifest": "vp run extension#test:manifest",
    "deps": "depcruise packages tests --config .dependency-cruiser.cjs && depcruise apps/website --config .dependency-cruiser.cjs --ts-config apps/website/tsconfig.deps.json && depcruise apps/extension --config .dependency-cruiser.cjs --ts-config apps/extension/tsconfig.deps.json",
    "dead-code": "knip",
    "duplication": "jscpd --threshold 1 --fail-on-empty apps/website/src apps/extension/src packages/domain/src packages/bridge/src packages/brand/src",
    "prepare": "vp config && vp run extension#wxt:prepare"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@recnrun/domain": "workspace:*",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dependency-cruiser": "catalog:",
    "eslint-plugin-sonarjs": "catalog:",
    "jscpd": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
