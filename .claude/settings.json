{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(vp check)",
      "Bash(vp check *)",
      "Bash(vp run deps)",
      "Bash(vp run test)",
      "Bash(vp run test *)",
      "Bash(vp run test:*)",
      "Bash(vp run verify)",
      "Bash(vp run verify *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/agent-hooks/pre-tool-use.mjs\"",
            "statusMessage": "Checking Git hook policy"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/agent-hooks/stop.mjs\"",
            "timeout": 150,
            "statusMessage": "Running quality checks"
          }
        ]
      }
    ]
  }
}
