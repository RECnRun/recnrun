{
  "manifest_version": 3,
  "name": "RECnRun origin snapshot lab",
  "version": "0.0.1",
  "description": "Lab extension: captures, clears, and restores one origin's storage per identity.",
  "permissions": [
    "scripting",
    "cookies",
    "tabs",
    "tabGroups",
    "webNavigation",
    "storage",
    "unlimitedStorage",
    "declarativeNetRequestWithHostAccess",
    "offscreen",
    "browsingData"
  ],
  "host_permissions": ["http://app.localhost/*", "http://sso.localhost/*"],
  "action": { "default_title": "Open the lab's dashboard" },
  "background": { "service_worker": "background.js", "type": "module" },
  "message_serialization": "structured_clone"
}
