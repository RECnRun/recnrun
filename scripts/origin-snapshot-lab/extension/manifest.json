{
  "manifest_version": 3,
  "name": "RECnRun origin snapshot lab",
  "version": "0.0.1",
  "description": "Lab extension: captures, clears, and restores one origin's storage per identity.",
  "permissions": [
    "scripting",
    "tabs",
    "webNavigation",
    "storage",
    "unlimitedStorage",
    "declarativeNetRequestWithHostAccess",
    "offscreen"
  ],
  "host_permissions": ["http://app.localhost/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "message_serialization": "structured_clone"
}
