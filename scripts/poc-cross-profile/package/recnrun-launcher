#!/bin/sh
# The package's one entry point: first-run is first-run.sh, every other command is recnrun-launcher.sh.
here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P) || exit 70
if [ "${1:-}" = first-run ]; then
  shift
  exec /bin/sh "$here/first-run.sh" "$@"
fi
exec /bin/sh "$here/recnrun-launcher.sh" "$@"
