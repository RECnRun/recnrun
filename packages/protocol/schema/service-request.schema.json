{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "command": {
      "enum": [
        "capabilities.get",
        "health",
        "profiles.list",
        "session.start",
        "session.status",
        "session.handoff",
        "session.pause",
        "session.resume",
        "session.stop",
        "browser.inspect",
        "browser.act",
        "flow.validate",
        "flow.addAssertion",
        "flow.finalize",
        "flow.replay",
        "run.summary",
        "run.queryEvents",
        "run.getArtifact",
        "run.compare",
        "issue.createReproducer",
        "locators.validate",
        "locators.preview",
        "functions.list",
        "functions.register",
        "functions.validate",
        "functions.test",
        "functions.call",
        "functions.proposeBuiltin",
        "macros.extract",
        "flow.list",
        "flow.get",
        "flow.save",
        "flow.import",
        "session.suggestions",
        "picker.start",
        "picker.stop",
        "events.subscribe"
      ],
      "type": "string"
    },
    "lease": {
      "additionalProperties": false,
      "properties": {
        "fencingToken": {
          "minimum": 1,
          "type": "integer"
        },
        "leaseId": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": ["leaseId", "fencingToken"],
      "type": "object"
    },
    "params": {},
    "requestId": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": ["requestId", "command", "params"],
  "type": "object"
}
