{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "createdAt": {
      "format": "date-time",
      "type": "string"
    },
    "nonce": {
      "minLength": 1,
      "type": "string"
    },
    "pid": {
      "minimum": 1,
      "type": "integer"
    },
    "schemaVersion": {
      "const": 1
    }
  },
  "required": ["schemaVersion", "pid", "nonce", "createdAt"],
  "type": "object"
}
