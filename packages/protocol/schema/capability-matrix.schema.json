{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "capabilities": {
      "items": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "id": {
                "pattern": "^[A-Za-z0-9][\\w.-]*$",
                "type": "string"
              },
              "kind": {
                "const": "surface"
              },
              "level": {
                "enum": ["normal", "deep"],
                "type": "string"
              },
              "notes": {
                "minLength": 1,
                "type": "string"
              },
              "phase": {
                "pattern": "^F\\d[A]?\\.\\d+$",
                "type": "string"
              },
              "status": {
                "enum": ["implemented", "partial", "unavailable", "planned"],
                "type": "string"
              },
              "surface": {
                "enum": [
                  "dom-events",
                  "navigation",
                  "network",
                  "websocket-sse",
                  "console-errors",
                  "dom-screen",
                  "web-storage",
                  "cookies",
                  "indexeddb",
                  "cache-storage",
                  "files-opfs",
                  "workers-frames"
                ],
                "type": "string"
              },
              "title": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": ["kind", "id", "surface", "level", "title", "status", "phase", "notes"],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "id": {
                "pattern": "^[A-Za-z0-9][\\w.-]*$",
                "type": "string"
              },
              "kind": {
                "const": "feature"
              },
              "notes": {
                "minLength": 1,
                "type": "string"
              },
              "phase": {
                "pattern": "^F\\d[A]?\\.\\d+$",
                "type": "string"
              },
              "status": {
                "enum": ["implemented", "partial", "unavailable", "planned"],
                "type": "string"
              },
              "title": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": ["kind", "id", "title", "status", "phase", "notes"],
            "type": "object"
          }
        ]
      },
      "type": "array"
    },
    "schemaVersion": {
      "const": 1
    }
  },
  "required": ["schemaVersion", "capabilities"],
  "type": "object"
}
