{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "createdAt": {
      "format": "date-time",
      "type": "string"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][\\w.-]*$",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "revision": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "revisions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "revision": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "savedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": ["revision", "savedAt"],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "enum": ["draft", "recorded", "validated", "incompatible", "needs-review"],
      "type": "string"
    },
    "updatedAt": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "revision",
    "status",
    "createdAt",
    "updatedAt",
    "revisions"
  ],
  "type": "object"
}
