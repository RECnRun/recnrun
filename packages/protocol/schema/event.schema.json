{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "enum": ["human", "agent", "replay", "unknown"],
          "type": "string"
        },
        "category": {
          "const": "gap"
        },
        "causalConfidence": {
          "enum": ["command-id", "initiator", "stack", "network-id", "temporal-only"],
          "type": "string"
        },
        "commandId": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "component": {
          "enum": ["application", "browser", "collector", "engine"],
          "type": "string"
        },
        "documentId": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "frameId": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "monotonicTimeMs": {
          "type": "number"
        },
        "payload": {
          "additionalProperties": false,
          "properties": {
            "fromSeq": {
              "minimum": 0,
              "type": "integer"
            },
            "lastSeq": {
              "minimum": 0,
              "type": "integer"
            },
            "lost": {
              "minimum": 0,
              "type": "integer"
            },
            "reason": {
              "enum": [
                "buffer-exhausted",
                "connection-lost",
                "journal-truncated",
                "target-unattached",
                "producer-restarted",
                "capture-suspended",
                "capture-stopped"
              ],
              "type": "string"
            },
            "startedAt": {
              "format": "date-time",
              "type": "string"
            },
            "surface": {
              "enum": [
                "dom-events",
                "navigation",
                "network",
                "websocket-sse",
                "console-errors",
                "dom-screen",
                "web-storage",
                "cookies",
                "indexeddb",
                "cache-storage",
                "files-opfs",
                "workers-frames"
              ],
              "type": "string"
            },
            "toSeq": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": ["reason"],
          "type": "object"
        },
        "payloadRef": {
          "minLength": 1,
          "type": "string"
        },
        "producer": {
          "minLength": 1,
          "type": "string"
        },
        "profileBinding": {
          "minLength": 1,
          "type": "string"
        },
        "receivedAt": {
          "format": "date-time",
          "type": "string"
        },
        "runId": {
          "minLength": 1,
          "type": "string"
        },
        "schemaVersion": {
          "const": 1
        },
        "seq": {
          "minimum": 0,
          "type": "integer"
        },
        "source": {
          "minLength": 1,
          "type": "string"
        },
        "stepId": {
          "minLength": 1,
          "type": "string"
        },
        "targetId": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "timestamp": {
          "format": "date-time",
          "type": "string"
        },
        "type": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "runId",
        "seq",
        "source",
        "producer",
        "timestamp",
        "targetId",
        "frameId",
        "documentId",
